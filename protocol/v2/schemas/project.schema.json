{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CU ERP Project Context V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "repo", "summary", "decisions", "updated_at"],
  "properties": {
    "schema_version": { "const": "2.0" },
    "project": { "enum": ["cu_gensite", "cu_fel", "cu_deploy", "helpdesk", "cu_erp_manager", "multi_ai_protocol"] },
    "repo": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "status", "ref_msg"],
        "properties": {
          "id": { "type": "string", "pattern": "^ADR-[0-9]{8}-[0-9]{3,}$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 160 },
          "status": { "enum": ["proposed", "accepted", "superseded"] },
          "ref_msg": { "type": ["string", "null"] }
        }
      }
    },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
