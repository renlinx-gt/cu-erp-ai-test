{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CU ERP Multi-AI Message V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "thread_id",
    "type",
    "created_at",
    "identity",
    "to",
    "ref_sha",
    "reply_to",
    "summary",
    "body",
    "approval"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^MSG-[0-9]{8}-[A-Z]+-[0-9]{3,}$" },
    "thread_id": { "type": "string", "pattern": "^THR-[A-Z0-9-]+$" },
    "type": { "enum": ["consulta", "propuesta", "revision", "bloqueo", "resumen"] },
    "created_at": { "type": "string", "format": "date-time" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claimed_agent", "authenticated_principal"],
      "properties": {
        "claimed_agent": { "enum": ["chatgpt", "claude", "gemini", "codex"] },
        "authenticated_principal": { "type": "string", "minLength": 1 }
      }
    },
    "to": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["chatgpt", "claude", "gemini", "codex", "human"] }
    },
    "ref_sha": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{40}$"
    },
    "reply_to": {
      "type": ["object", "null"],
      "required": ["message_id", "ref_sha"],
      "properties": {
        "message_id": { "type": "string", "pattern": "^MSG-[0-9]{8}-[A-Z]+-[0-9]{3,}$" },
        "ref_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "summary": { "type": "string", "minLength": 1, "maxLength": 240 },
    "body": { "type": "string", "minLength": 1 },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "human_approved_by"],
      "properties": {
        "required": { "type": "boolean" },
        "human_approved_by": { "type": ["string", "null"] }
      }
    }
  }
}
